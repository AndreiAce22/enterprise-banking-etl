      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{67A84F53-2170-4D5A-A4F6-1328BE344644}"
          SQLTask:SqlStatementSource="&#xA;&#xA;/* =========================================&#xA;   1. DIM DATE&#xA;========================================= */&#xA;&#xA;IF OBJECT_ID('dw.DimDate', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dw.DimDate&#xA;    (&#xA;        DateKey INT NOT NULL,&#xA;        FullDate DATE NOT NULL,&#xA;        DayNumber TINYINT NOT NULL,&#xA;        DayName VARCHAR(10) NOT NULL,&#xA;        WeekNumber TINYINT NOT NULL,&#xA;        MonthNumber TINYINT NOT NULL,&#xA;        MonthName VARCHAR(10) NOT NULL,&#xA;        QuarterNumber TINYINT NOT NULL,&#xA;        YearNumber SMALLINT NOT NULL,&#xA;        IsWeekend BIT NOT NULL,&#xA;        IsMonthEnd BIT NOT NULL,&#xA;&#xA;        CONSTRAINT PK_DimDate&#xA;            PRIMARY KEY CLUSTERED (DateKey),&#xA;&#xA;        CONSTRAINT UQ_DimDate_FullDate&#xA;            UNIQUE NONCLUSTERED (FullDate)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;/* =========================================&#xA;   2. DIM BRANCH&#xA;========================================= */&#xA;&#xA;IF OBJECT_ID('dw.DimBranch', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dw.DimBranch&#xA;    (&#xA;        BranchKey INT IDENTITY(1,1) NOT NULL,&#xA;        BranchID INT NOT NULL,&#xA;        BranchCode VARCHAR(10) NOT NULL,&#xA;        BranchName VARCHAR(100) NOT NULL,&#xA;        City VARCHAR(50) NOT NULL,&#xA;        Region VARCHAR(50) NOT NULL,&#xA;        OpenDate DATE NOT NULL,&#xA;        BranchStatus VARCHAR(15) NOT NULL,&#xA;        EffectiveStartDate DATETIME2(0) NOT NULL,&#xA;        EffectiveEndDate DATETIME2(0) NOT NULL,&#xA;        IsCurrent BIT NOT NULL,&#xA;        CreatedAt DATETIME2(6) NOT NULL,&#xA;&#xA;        CONSTRAINT PK_DimBranch&#xA;            PRIMARY KEY CLUSTERED (BranchKey)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;/* =========================================&#xA;   3. DIM CUSTOMER&#xA;========================================= */&#xA;&#xA;IF OBJECT_ID('dw.DimCustomer', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dw.DimCustomer&#xA;    (&#xA;        CustomerKey INT IDENTITY(1,1) NOT NULL,&#xA;        CustomerID INT NOT NULL,&#xA;        FirstName VARCHAR(50) NULL,&#xA;        LastName VARCHAR(50) NULL,&#xA;        DateOfBirth DATETIME2(7) NULL,&#xA;        Email VARCHAR(120) NULL,&#xA;        PhoneNumber VARCHAR(20) NULL,&#xA;        City VARCHAR(50) NULL,&#xA;        CustomerSince DATETIME2(7) NULL,&#xA;        CustomerStatus VARCHAR(15) NULL,&#xA;        EffectiveStartDate DATETIME2(7) NOT NULL,&#xA;        EffectiveEndDate DATETIME2(7) NOT NULL,&#xA;        IsCurrent BIT NOT NULL,&#xA;        CreatedAt DATETIME2(7) NOT NULL,&#xA;&#xA;        CONSTRAINT PK_DimCustomer&#xA;            PRIMARY KEY CLUSTERED (CustomerKey)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;/* =========================================&#xA;   4. DIM ACCOUNT&#xA;========================================= */&#xA;&#xA;IF OBJECT_ID('dw.DimAccount', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dw.DimAccount&#xA;    (&#xA;        AccountKey INT IDENTITY(1,1) NOT NULL,&#xA;        AccountID INT NOT NULL,&#xA;        AccountNumber VARCHAR(30) NOT NULL,&#xA;        CustomerID INT NOT NULL,&#xA;        BranchID INT NOT NULL,&#xA;        AccountType VARCHAR(30) NOT NULL,&#xA;        AccountStatus VARCHAR(20) NOT NULL,&#xA;        CurrencyCode CHAR(3) NOT NULL,&#xA;        OpenDate DATE NOT NULL,&#xA;        CloseDate DATE NULL,&#xA;        EffectiveStartDate DATETIME2(7) NOT NULL,&#xA;        EffectiveEndDate DATETIME2(7) NOT NULL,&#xA;        IsCurrent BIT NOT NULL,&#xA;        CreatedAt DATETIME2(7) NOT NULL,&#xA;&#xA;        CONSTRAINT PK_DimAccount&#xA;            PRIMARY KEY CLUSTERED (AccountKey)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;/* =========================================&#xA;   5. DIM LOAN&#xA;========================================= */&#xA;&#xA;IF OBJECT_ID('dw.DimLoan', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dw.DimLoan&#xA;    (&#xA;        LoanKey INT IDENTITY(1,1) NOT NULL,&#xA;        LoanID INT NOT NULL,&#xA;        CustomerID INT NOT NULL,&#xA;        BranchID INT NOT NULL,&#xA;        LoanAccountNumber VARCHAR(25) NOT NULL,&#xA;        LoanType VARCHAR(30) NOT NULL,&#xA;        LoanStatus VARCHAR(20) NOT NULL,&#xA;        PrincipalAmount DECIMAL(16,2) NOT NULL,&#xA;        AnnualInterestRate DECIMAL(5,2) NOT NULL,&#xA;        LoanTermMonths INT NOT NULL,&#xA;        ApplicationDate DATE NOT NULL,&#xA;        DisbursementDate DATE NULL,&#xA;        MaturityDate DATE NULL,&#xA;        EffectiveStartDate DATETIME2(7) NOT NULL,&#xA;        EffectiveEndDate DATETIME2(7) NOT NULL,&#xA;        IsCurrent BIT NOT NULL,&#xA;        CreatedAt DATETIME2(7) NOT NULL,&#xA;&#xA;        CONSTRAINT PK_DimLoan&#xA;            PRIMARY KEY CLUSTERED (LoanKey)&#xA;    );&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
